# WhatsApp Promotion Platform — environment reference (names + descriptions only; never commit values)
# Copy to .env and fill in. Secrets are marked. See docs/release/configuration.md.

# local | test | staging | production (stored in schema_meta on first boot; production enables activation gates)
ENVIRONMENT=local

# bind address (0.0.0.0 on Railway)
HOST=127.0.0.1

# HTTP port
PORT=5191

# SQLite file (WAL). Railway: /app/data/promotions.db on the mounted volume
DATABASE=./data/promotions.db

# private receipt media directory (never served publicly)
MEDIA_DIR=./data/media

# public HTTPS base of this service (webhook + console links)
PUBLIC_BASE_URL=

# bootstrap platform_admin (first run only)
ADMIN_EMAIL=admin@example.com

# bootstrap password (>=12 chars); required on public deployments [secret]
ADMIN_PASSWORD=

# AES-256-GCM key material for identity numbers; required outside local [secret]
IDENTITY_KEY=

# HMAC key for signed audit checkpoints (draw bundles) [secret]
AUDIT_CHECKPOINT_KEY=

# country code prefixed to local numbers (test assumption D-04)
DEFAULT_COUNTRY_CODE=263

# simulator | cloud-api | linked-device (linked-device is dev only)
WHATSAPP_TRANSPORT=simulator

# Graph API version
META_API_VERSION=v21.0

# Cloud API phone number id
META_PHONE_NUMBER_ID=

# WhatsApp Business Account id
META_WABA_ID=

# Meta app id
META_APP_ID=

# Meta app secret (webhook signature) [secret]
META_APP_SECRET=

# system-user access token [secret]
META_ACCESS_TOKEN=

# verify token for the webhook handshake; also seeds media-link signing [secret]
WHATSAPP_WEBHOOK_TOKEN=

# linked-device session dir (dev only)
BAILEYS_AUTH_DIR=./data/baileys

# tesseract (real, offline) | vision (real, needs key) | simulator (TEST ONLY)
RECEIPT_EXTRACTOR=tesseract

# vision-LLM key (OpenAI-compatible) [secret]
RECEIPT_PROVIDER_OPENAI_API_KEY=

# vision model
RECEIPT_PROVIDER_OPENAI_MODEL=gpt-4o

# vision endpoint base
RECEIPT_PROVIDER_BASE_URL=https://api.openai.com/v1

# per-image extraction timeout
RECEIPT_OCR_TIMEOUT_MS=45000

# none | webhook (generic contract; use scripts/crm-receiver.mjs locally)
CRM_PROVIDER=none

# CRM endpoint base (POST /events, GET /records/:type/:key, GET /health)
CRM_WEBHOOK_URL=

# bearer for the CRM endpoint [secret]
CRM_WEBHOOK_TOKEN=

# CRM call timeout
CRM_TIMEOUT_MS=10000

# CSPRNG seed length committed at freeze
DRAW_RANDOM_BYTES=32

# raw receipt image retention (D-22 pending)
RETENTION_RAW_RECEIPTS_DAYS=90

# extracted facts retention (D-22 pending)
RETENTION_FACTS_DAYS=180

# legacy desk AI wrapper (optional)
AI_PROVIDER=none

# legacy desk AI key [secret]
AI_PROVIDER_API_KEY=

# legacy desk AI budget
AI_MONTHLY_BUDGET_USD=0

# log level
LOG_LEVEL=info

# non-production only: after boot, push the fixture receipts through the real pipeline and run the sample draw (~1-2 min) so every screen has data
SEED_POPULATED=false

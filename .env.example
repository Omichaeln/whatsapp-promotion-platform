# =============================================================================
# WhatsApp Promotion Platform - environment reference (no secret values)
# Copy to .env and fill in. Never commit real values.
# =============================================================================

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=5191
DATABASE=./data/promotions.db
MEDIA_DIR=./data/media
LOG_LEVEL=info

# --- Admin bootstrap ------------------------------------------------------
# First-run creates this admin (scrypt-hashed at startup). Change after login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- WhatsApp Cloud API (Meta) --- production transport -------------------
# Get these from the Meta Developer app + WABA. Required for webhook verify.
WHATSAPP_TRANSPORT=cloud-api        # cloud-api | linked-device | simulator
META_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Public HTTPS base of this service (for media callback URLs and webhooks).
PUBLIC_BASE_URL=
WHATSAPP_WEBHOOK_TOKEN=             # string you choose; Meta sends it in verify handshake
# Optional legacy demo channel (Baileys linked device). Keep OFF in production.
BAILEYS_AUTH_DIR=./data/baileys

# --- Receipt intelligence -------------------------------------------------
RECEIPT_EXTRACTOR=simulator          # simulator | vision | none
RECEIPT_PROVIDER_OPENAI_API_KEY=
RECEIPT_PROVIDER_OPENAI_MODEL=gpt-4o
RECEIPT_PROVIDER_BASE_URL=https://api.openai.com/v1
# Corresponding receivable "progress" thresholds (benchmark-approved before launch)
RECEIPT_AUTO_QUALIFY_MIN_CONFIDENCE=0.9
RECEIPT_AUTO_QUALIFY_MAX_REVIEW_RATE=0.35

# --- AI wrapper (optional, from the original desk) -------------------------
AI_PROVIDER=openrouter
AI_PROVIDER_API_KEY=
AI_MODEL=deepseek/deepseek-chat-v3-0324
AI_MONTHLY_BUDGET_USD=20

# --- CRM ------------------------------------------------------------------
CRM_PROVIDER=none                     # none | webhook | (contract pending D-14)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# --- Draw -----------------------------------------------------------------
DRAW_RANDOM_BYTES=32                  # entropy for HMAC sortition (>=16)

# --- Ops ------------------------------------------------------------------
RETENTION_RAW_RECEIPTS_DAYS=90
RETENTION_FACTS_DAYS=180
EXPORT_WATERMARK=true
{
  "name": "whatsapp-promotion-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp promotion platform: registration, consent, real receipt OCR + deterministic qualification, canonical-receipt duplicate prevention, immutable entry ledger, crash-safe auditable draws with independent verifier, winner/claim lifecycle, CRM outbox with read-back, staff console.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "preflight": "node --no-warnings=ExperimentalWarning scripts/preflight.mjs",
    "migrate": "node --no-warnings=ExperimentalWarning src/db.js migrate",
    "seed": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/seed-demo.mjs",
    "seed:light": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/seed-demo.mjs --light",
    "reset:sample": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/reset-sample.mjs --confirm",
    "fixtures": "node --no-warnings=ExperimentalWarning scripts/gen-fixtures.mjs",
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "worker": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/worker.js",
    "crm:receiver": "node --no-warnings=ExperimentalWarning scripts/crm-receiver.mjs",
    "web:build": "cd src/web-console && npm install --no-audit --no-fund && npm run build && rm -rf ../web-console-dist && cp -R dist ../web-console-dist",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 test/*.test.mjs",
    "test:e2e": "node --no-warnings=ExperimentalWarning --test test/e2e/*.e2e.mjs",
    "bench": "node --no-warnings=ExperimentalWarning bench/run.mjs --out docs/testing/evidence/receipt-benchmark.json",
    "load": "node --no-warnings=ExperimentalWarning bench/load.mjs --out docs/testing/evidence/load-benchmark.json",
    "verify:draw": "node --no-warnings=ExperimentalWarning scripts/verify-draw-bundle.mjs",
    "restore:rehearsal": "node --no-warnings=ExperimentalWarning scripts/backup-restore-rehearsal.mjs --out docs/testing/evidence/restore-rehearsal.json",
    "smoke:remote": "node --no-warnings=ExperimentalWarning scripts/remote-smoke.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "check": "for f in $(find src scripts test bench -name '*.mjs' -o -name '*.js' | grep -v web-console); do node --check \"$f\" || exit 1; done && echo 'check ok'",
    "ci": "npm run check && npm test && npm run bench && npm run audit:deps"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "baileys": "^7.0.0-rc14",
    "qrcode": "^1.5.4",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0"
  }
}
